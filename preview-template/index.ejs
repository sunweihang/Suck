<html>
    <head>
        <link rel="icon" href="./favicon.ico" />
        <meta charset="utf-8" />
        <title><%=title%></title>
        <meta
            name="viewport"
            content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true,viewport-fit=cover"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="full-screen" content="yes" />
        <meta name="screen-orientation" content="portrait" />
        <meta name="x5-fullscreen" content="true" />
        <meta name="360-fullscreen" content="true" />
        <meta name="renderer" content="webkit" />
        <meta name="force-rendering" content="webkit" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

        <link rel="stylesheet" type="text/css" href="./index.css" />
        <link rel="preload" as="image" href="./splash_screen.png" />
        <style>
            #splash {
                display: none !important;
            }
            #SplashOverlay {
                position: absolute;
                inset: 0;
                z-index: 99999;
                overflow: hidden;
                background: #fefff1;
                pointer-events: none;
            }
            #SplashOverlay.is-done {
                display: none !important;
            }
            #SplashOverlay img {
                position: absolute;
                left: 50%;
                top: 50%;
                width: 100%;
                height: auto;
                transform: translate(-50%, -50%);
                display: block;
            }

            /*
             * Tall window: fill (FIXED_WIDTH). Wide window: 9:16 frame, side bars.
             * game-frame.js writes --game-frame-width / height.
             */
            .content,
            .contentWrap {
                background-color: #000 !important;
            }
            #GameDiv {
                position: relative !important;
                flex: none !important;
                /* Fallback before game-frame.js: already 1080-wide, no large→small jump. */
                width: var(--game-frame-width, min(100%, calc(100vh * 1080 / 1920))) !important;
                height: var(--game-frame-height, 100%) !important;
                max-width: 100% !important;
                max-height: 100% !important;
                margin: auto !important;
                overflow: hidden !important;
                background-color: #000 !important;
            }
            #Cocos3dGameContainer,
            #GameCanvas {
                width: 100% !important;
                height: 100% !important;
                background-color: #000 !important;
            }

            /* Hide Cocos preview debug toolbar (design res / FPS / Pause). */
            .toolbar {
                display: none !important;
            }
            .content {
                top: 0 !important;
                height: 100% !important;
            }
        </style>
    </head>
    <body style="overflow: hidden; background-color: #000;">
        <%# Toolbar kept in template for Cocos preview injection; hidden via CSS above. %>
        <%- include(cocosToolBar, {config: config}) %>
        <div id="content" class="content" style="overflow: hidden; background-color: #000;">
            <div class="contentWrap">
                <!-- Portrait frame; tall windows fill, wide windows letterbox sides. -->
                <div id="GameDiv" class="wrapper" cc_exact_fit_screen="false">
                    <div id="Cocos3dGameContainer">
                        <canvas id="GameCanvas" tabindex="-1" style="background-color: #000;"></canvas>
                    </div>
                    <div id="splash">
                        <div class="progress-bar stripes"><span></span></div>
                    </div>
                    <div id="SplashOverlay">
                        <img src="./splash_screen.png" alt="轻玩星球" draggable="false"/>
                    </div>
                    <div id="bulletin">
                        <div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div>
                    </div>
                    <div class="error" id="error">
                        <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
                        <div class="error-main"></div>
                        <div class="error-stack"></div>
                    </div>
                </div>
            </div>
        </div>
        <%- include(cocosTemplate, {}) %>
        <script>
            (function () {
                var settings = window._CCSettings;
                if (!settings) {
                    return;
                }
                var splash = settings.splashScreen || (settings.splashScreen = {});
                splash.totalTime = 0;
                splash.displayRatio = 1;
                splash.logo = { type: 'none' };
                splash.background = {
                    type: 'color',
                    color: { x: 254 / 255, y: 255 / 255, z: 241 / 255, w: 1 },
                };
            })();

            (function () {
                var SPLASH_MIN_MS = 400;
                var shownAt = Date.now();
                var done = false;
                function hideSplash() {
                    if (done) return;
                    done = true;
                    var el = document.getElementById('SplashOverlay');
                    if (el) el.classList.add('is-done');
                }
                var homeReady = false;
                var minElapsed = false;
                var tryHide = function () {
                    if (homeReady && minElapsed) hideSplash();
                };
                window.setTimeout(function () {
                    minElapsed = true;
                    tryHide();
                }, SPLASH_MIN_MS);
                if (window.__unravelHomeReady) {
                    homeReady = true;
                    tryHide();
                } else {
                    var prev = window.__unravelNotifyHomeReady;
                    window.__unravelNotifyHomeReady = function () {
                        try { if (typeof prev === 'function') prev(); } catch (e) {}
                        homeReady = true;
                        tryHide();
                    };
                }
                window.setTimeout(hideSplash, 12000);
            })();
        </script>
        <script src="./game-frame.js"></script>
    </body>
</html>
