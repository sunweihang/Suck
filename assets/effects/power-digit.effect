CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: digit-vs:vert
      frag: digit-fs:frag
      properties:
        mainTexture: { value: grey }
        mainColor:   { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
      depthStencilState:
        depthTest: true
        depthWrite: true
        depthFunc: less
      blendState:
        targets:
        - blend: false
      rasterizerState:
        cullMode: none
}%

CCProgram digit-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  out vec2 v_uv;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    v_uv = a_texCoord;
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    return cc_matProj * cc_matView * matWorld * In.position;
  }
}%

CCProgram digit-fs %{
  precision highp float;
  #include <legacy/output-standard>

  in vec2 v_uv;
  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
  };

  vec4 frag () {
    vec4 tex = texture(mainTexture, v_uv);
    if (tex.a < 0.5) discard;
    tex.a = 1.0;
    tex.rgb = SRGBToLinear(tex.rgb);
    return CCFragOutput(tex * mainColor);
  }
}%
