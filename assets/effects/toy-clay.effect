CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: clay-vs:vert
      frag: clay-fs:frag
      properties:
        mainColor: { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
      depthStencilState:
        depthTest: true
        depthWrite: true
      rasterizerState:
        cullMode: back
}%

CCProgram clay-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  out vec2 v_uv;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    v_uv = a_texCoord;
    return cc_matProj * cc_matView * (matWorld * In.position);
  }
}%

CCProgram clay-fs %{
  precision highp float;
  #include <legacy/output-standard>

  in vec2 v_uv;
  uniform Constant {
    vec4 mainColor;
  };

  vec4 frag () {
    /* Official look is unlit albedo + a little emission. No dir light, no spec. */
    float edge = min(min(v_uv.x, v_uv.y), min(1.0 - v_uv.x, 1.0 - v_uv.y));
    float ao = mix(0.86, 1.0, smoothstep(0.0, 0.07, edge));
    vec3 col = mainColor.rgb * ao;
    return CCFragOutput(vec4(col, mainColor.a));
  }
}%
