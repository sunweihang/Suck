CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: clay-vs:vert
      frag: clay-fs:frag
      properties:
        mainTexture: { value: grey }
        mainColor:   { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
      depthStencilState:
        depthTest: true
        depthWrite: true
      rasterizerState:
        cullMode: back
}%

CCProgram clay-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  out vec3 v_viewNormal;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec3 worldN = normalize((matWorldIT * vec4(In.normal.xyz, 0.0)).xyz);
    v_viewNormal = (cc_matView * vec4(worldN, 0.0)).xyz;
    return cc_matProj * (cc_matView * matWorld) * In.position;
  }
}%

CCProgram clay-fs %{
  precision highp float;
  #include <legacy/output-standard>

  in vec3 v_viewNormal;
  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
  };

  vec4 frag () {
    vec3 n = normalize(v_viewNormal);
    vec2 uv = clamp(n.xy * 0.5 + 0.5, 0.0, 1.0);
    vec4 tex = texture(mainTexture, uv);
    tex.rgb = SRGBToLinear(tex.rgb);
    return CCFragOutput(tex * mainColor);
  }
}%
