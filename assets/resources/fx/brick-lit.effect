CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: brick-vs:vert
      frag: brick-fs:frag
      properties:
        mainColor: { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
        emissive:  { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
        roughness: { value: 0.34, target: pbrParams.x }
        metallic:  { value: 0.04, target: pbrParams.y }
        emit:      { value: 0.04, target: pbrParams.z }
      depthStencilState:
        depthTest: true
        depthWrite: true
      rasterizerState:
        cullMode: back
}%

CCProgram brick-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  out vec3 v_worldN;
  out vec3 v_worldP;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 wp = matWorld * In.position;
    v_worldP = wp.xyz;
    v_worldN = normalize((matWorldIT * vec4(In.normal.xyz, 0.0)).xyz);
    return cc_matProj * cc_matView * wp;
  }
}%

CCProgram brick-fs %{
  precision highp float;
  #include <common/common-define>
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>

  in vec3 v_worldN;
  in vec3 v_worldP;

  uniform Constant {
    vec4 mainColor;
    vec4 emissive;
    vec4 pbrParams;
  };

  float GGXMobile (float roughness, float NoH, vec3 H, vec3 N) {
    vec3 NxH = cross(N, H);
    float OneMinusNoHSqr = dot(NxH, NxH);
    float a = roughness * roughness;
    float n = NoH * a;
    float p = a / max(EPSILON, OneMinusNoHSqr + n * n);
    return p * p;
  }

  vec3 BRDFApprox (vec3 specular, float roughness, float NoV) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
    vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
    AB.y *= clamp(50.0 * specular.g, 0.0, 1.0);
    return max(vec3(0.0), specular * AB.x + AB.y);
  }

  vec4 frag () {
    float roughness = max(pbrParams.x, 0.04);
    float metallic = clamp(pbrParams.y, 0.0, 1.0);
    float emit = max(pbrParams.z, 0.0);

    vec3 albedo = mainColor.rgb;
    vec3 diffuse = albedo * (1.0 - metallic);
    vec3 specular = mix(vec3(0.04), albedo, metallic);

    vec3 N = normalize(v_worldN);
    vec3 V = normalize(cc_cameraPos.xyz - v_worldP);
    vec3 L = normalize(-cc_mainLitDir.xyz);
    float NL = max(dot(N, L), 0.0);
    float NV = max(abs(dot(N, V)), 0.0);

    specular = BRDFApprox(specular, roughness, NV);
    vec3 H = normalize(L + V);
    float NH = max(dot(N, H), 0.0);
    float specTerm = (roughness * 0.25 + 0.25) * GGXMobile(roughness, NH, H, N);

    vec3 lightingColor = NL * cc_mainLitColor.rgb * cc_mainLitColor.w;
    vec3 finalColor = lightingColor * (diffuse * INV_PI + specular * specTerm);

    float fAmb = max(EPSILON, 0.5 - N.y * 0.5);
    vec3 ambDiff = mix(cc_ambientSky.rgb, cc_ambientGround.rgb, fAmb);
    finalColor += ambDiff * cc_ambientSky.w * diffuse;

    vec3 R = normalize(reflect(-V, N));
    float fEnv = max(EPSILON, 0.5 - R.y * 0.5);
    vec3 env = mix(cc_ambientSky.rgb, cc_ambientGround.rgb, fEnv);
    finalColor += env * cc_ambientSky.w * specular;

    finalColor += emissive.rgb * emit;
    return CCFragOutput(vec4(finalColor, mainColor.a));
  }
}%
